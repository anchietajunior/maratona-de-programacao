<%= turbo_stream_from :staff_submissions %>
<%= turbo_stream_from :staff_clarifications %>

<nav class="mb-xl flex flex-wrap items-center justify-between gap-base border-b border-hairline pb-base">
  <div class="flex flex-wrap items-center gap-md">
    <%= link_to t("nav.dashboard"), staff_root_path, class: "text-nav-link text-ink" %>
    <%= link_to t("nav.problems"), staff_problems_path, class: "text-nav-link text-ink" %>
    <%= link_to t("nav.submissions"), staff_submissions_path, class: "text-nav-link text-ink" %>
    <%= link_to t("nav.clarifications"), staff_clarifications_path, class: "text-nav-link text-ink" %>
    <%= link_to t("nav.balloons"), staff_balloons_path, class: "text-nav-link text-ink" %>
    <%= link_to t("nav.standings"), staff_standings_path, class: "text-nav-link text-ink" %>
  </div>

  <div class="flex items-center gap-base">
    <%= render "layouts/clock" %>
    <span class="text-body-sm text-muted"><%= Current.user.name %></span>
    <%= button_to t("sessions.destroy.submit"), session_path, method: :delete,
          class: "cursor-pointer rounded-md border border-hairline-strong bg-surface-card px-base py-xs text-button text-ink" %>
  </div>
</nav>

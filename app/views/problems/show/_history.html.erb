<section class="mt-xl">
  <h2 class="text-display-sm"><%= t("problems.show.history") %></h2>

  <% if submissions.any? %>
    <ul class="mt-base divide-y divide-hairline rounded-lg border border-hairline bg-surface-card">
      <% submissions.each do |submission| %>
        <%= render "submissions/submission", submission: submission %>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-xs text-body-sm text-muted"><%= t("problems.show.no_submissions") %></p>
  <% end %>
</section>

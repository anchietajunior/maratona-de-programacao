<%= form_with model: [ :staff, problem ], class: "mt-xl max-w-prose" do |form| %>
  <% if problem.errors.any? %>
    <div class="mb-lg rounded-md border border-hairline-strong bg-surface-card p-base">
      <ul class="text-body-sm text-error">
        <% problem.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-base">
    <%= form.label :title, t("staff.problems.form.title_field"), class: "block text-body-sm text-body" %>
    <%= form.text_field :title, required: true,
          class: "mt-xxs block h-[44px] w-full rounded-md border border-hairline-strong bg-surface-card px-base text-body-md text-ink focus:outline-primary" %>
  </div>

  <div class="mb-base">
    <%= form.label :difficulty, t("staff.problems.form.difficulty"), class: "block text-body-sm text-body" %>
    <%= form.select :difficulty,
          Problem::POINTS.keys.map { |level| [ t("problems.difficulties.#{level}"), level ] },
          {},
          class: "mt-xxs block h-[44px] w-full rounded-md border border-hairline-strong bg-surface-card px-base text-body-md text-ink focus:outline-primary" %>
  </div>

  <div class="mb-base">
    <%= form.label :statement, t("staff.problems.form.statement"), class: "block text-body-sm text-body" %>
    <p class="text-body-sm text-muted"><%= t("staff.problems.form.statement_hint") %></p>
    <%= form.text_area :statement, rows: 16, required: true,
          class: "mt-xxs block w-full rounded-lg border border-hairline-strong bg-surface-card p-base font-mono text-code text-ink focus:outline-primary" %>
  </div>

  <div class="mb-lg">
    <%= form.label :reference_solution, t("staff.problems.form.reference_solution"), class: "block text-body-sm text-body" %>
    <p class="text-body-sm text-muted"><%= t("staff.problems.form.reference_solution_hint") %></p>
    <%= form.text_area :reference_solution, rows: 12, required: true, spellcheck: false,
          class: "mt-xxs block w-full rounded-lg border border-hairline-strong bg-surface-card p-base font-mono text-code text-ink focus:outline-primary" %>
  </div>

  <%= form.submit t("staff.problems.form.submit"),
        class: "h-[40px] cursor-pointer rounded-md bg-primary px-md text-button text-on-primary" %>
<% end %>

<li class="rounded-lg border border-hairline bg-surface-card p-lg">
  <div class="flex flex-wrap items-center justify-between gap-sm">
    <p class="text-caption-uppercase uppercase text-muted"><%= t("staff.testcases.number", number: number) %></p>
    <%= button_to t("staff.testcases.remove"), staff_problem_testcase_path(problem, testcase), method: :delete,
          class: "cursor-pointer rounded-md border border-hairline-strong bg-surface-card px-base py-xs text-button text-error" %>
  </div>

  <div class="mt-base grid gap-base sm:grid-cols-2">
    <div>
      <p class="text-body-sm text-muted"><%= t("staff.testcases.input") %></p>
      <pre class="mt-xxs overflow-x-auto rounded-md border border-hairline bg-canvas-soft p-sm font-mono text-code text-ink"><%= as_text(testcase.input) %></pre>
    </div>
    <div>
      <p class="text-body-sm text-muted"><%= t("staff.testcases.expected_output") %></p>
      <pre class="mt-xxs overflow-x-auto rounded-md border border-hairline bg-canvas-soft p-sm font-mono text-code text-ink"><%= as_text(testcase.expected_output) %></pre>
    </div>
  </div>
</li>
